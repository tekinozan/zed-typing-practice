{
  "name": "zed-typing-lsp",
  "version": "0.2.0",
  "description": "Language server powering the Typing Practice extension for Zed: test generation, live typing metrics and HTML reports.",
  "keywords": ["zed", "zed-extension", "language-server", "typing", "wpm"],
  "license": "MIT",
  "author": "Diyar Ozan Tekin <diyarozantekin@gmail.com>",
